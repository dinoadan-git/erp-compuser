[Unit]
Description=CSA EPSON ERP API
After=network.target postgresql.service

[Service]
Type=simple
User=csa
WorkingDirectory=/opt/erp-compuser/backend
EnvironmentFile=/opt/erp-compuser/backend/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
